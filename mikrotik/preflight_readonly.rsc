# Read-only inventory. Does not export credentials or change configuration.
/system/resource/print
/system/package/print
/system/device-mode/print
/disk/print detail
/interface/bridge/print
/interface/veth/print
/ip/address/print
/ip/service/print
/ip/firewall/filter/print
/ip/firewall/nat/print
/ip/dhcp-server/lease/print detail where mac-address=E8:9C:25:4C:4C:CA
